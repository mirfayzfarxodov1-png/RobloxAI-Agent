# Node.js 22.13+; no npm packages are required.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
# Required. Keep this key only on the server; never commit a real .env file.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-5-5
MAX_TOKENS=8000
MAX_STEPS=60
DAILY_STEP_LIMIT=300
COMMAND_TIMEOUT_MS=60000
# Local HTTP uses false. Production HTTPS should use true.
COOKIE_SECURE=false
TRUST_PROXY=false
# Optional: if set, registration requires this code.
INVITE_CODE=
