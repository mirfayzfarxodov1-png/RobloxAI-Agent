# Copy this file to .env. Never commit your real .env file.
NODE_ENV=development
PORT=8787
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DATABASE_PATH=./data/quruvchi.sqlite
DAILY_STEP_LIMIT=300
# Obtain a valid key from your AI provider account. Keep it server-side only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest
# Set true only when served over HTTPS in production.
COOKIE_SECURE=false
# Optional: if set, registration requires this invite code.
INVITE_CODE=
