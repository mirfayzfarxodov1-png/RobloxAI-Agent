# Node.js 22.13+; no npm packages are required.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
# Required. Keep this key only on the server; never commit a real .env file.
ANTHROPIC_API_KEY=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
