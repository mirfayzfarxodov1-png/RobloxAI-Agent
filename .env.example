# Node.js 22.13+; no npm packages are required.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
MAX_TOKENS=12000
MAX_STEPS=120
DAILY_STEP_LIMIT=500
COMMAND_TIMEOUT_MS=60000
# Local HTTP uses false. Production HTTPS should use true.
COOKIE_SECURE=false
TRUST_PROXY=false
# Optional: if set, registration requires this code.
INVITE_CODE=
